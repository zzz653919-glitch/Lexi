# Copy to .env for local use, or set these in your hosting dashboard. Never commit real values.
NODE_ENV=production
PORT=3000
# Directory for the SQLite database and uploaded audio (must be a persistent disk/volume)
LEXI_DATA_DIR=./data
# Public address of the site (used in password-reset links)
PUBLIC_URL=https://your-domain.example
# Optional overrides (defaults are right behind an HTTPS proxy): COOKIE_SECURE=1, TRUST_PROXY=1, HOST=0.0.0.0, LEXI_NO_SEED=1
# One-time administrator creation: ADMIN_EMAIL=you@example.com ADMIN_PASSWORD=<choose a strong password> npm run create-admin
